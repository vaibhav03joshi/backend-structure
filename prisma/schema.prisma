generator client {
    provider = "prisma-client"
    output   = "../src/generated"
}

datasource db {
    provider = "postgresql"
}

model User {
    id              String   @id @default(cuid())
    email           String   @unique
    name            String
    googleSubjectId String   @unique
    username        String   @unique
    profileUrl      String
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
}
